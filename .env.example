# Secrets and infrastructure only. Business rules live in the database (Settings screens).
# Copy to .env.local for local development; set the same names in Vercel for deploys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app. Local: http://localhost:3000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Integrations. All optional: the app runs without them and the feature that needs a missing one
# says "not connected yet" in Settings. See SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# Shared secret for the every-minute checker (POST /api/cron/check-shifts). Any long random string.
# The same value goes into Supabase Vault as `cron_secret`.
CRON_SECRET=

# Google service account key file (the whole JSON on one line, or base64 of it). Used for both
# Gmail alerts and Calendar invites, through domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Mailbox the alert emails are sent from (a real Workspace user, or an alias of one).
ALERT_EMAIL_SENDER=
# Workspace user who owns the shared shifts calendar.
GOOGLE_CALENDAR_OWNER=

# Telegram bot from @BotFather. Username without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string (letters, digits, _ and - only). Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
