# Secrets and infrastructure only. Business rules live in the database (Settings screens).
# Copy to .env.local for local development; set the same names in Vercel for deploys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app. Local: http://localhost:3000
APP_URL=http://localhost:3000
